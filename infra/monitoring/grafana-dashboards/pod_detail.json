{
  "title": "Pod Detail",
  "uid": "pod-detail",
  "tags": ["kubernetes", "pod"],
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": { "uid": "prometheus" },
        "query": "label_values(kube_pod_info, namespace)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": { "uid": "prometheus" },
        "query": "label_values(kube_pod_info{namespace=\"$namespace\"}, pod)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "container",
        "label": "Container",
        "type": "query",
        "datasource": { "uid": "prometheus" },
        "query": "label_values(kube_pod_container_info{namespace=\"$namespace\", pod=\"$pod\"}, container)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": true
      }
    ]
  },
  "panels": [
    {
      "id": 1, "title": "Pod Status", "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "prometheus" },
      "targets": [{
        "expr": "kube_pod_status_phase{namespace=\"$namespace\", pod=\"$pod\"}",
        "legendFormat": "{{phase}}"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 2, "title": "Container Count", "type": "stat",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "prometheus" },
      "targets": [{
        "expr": "count(kube_pod_container_info{namespace=\"$namespace\", pod=\"$pod\"})",
        "legendFormat": "Containers"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 3, "title": "Total Restarts", "type": "stat",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "prometheus" },
      "targets": [{
        "expr": "sum(kube_pod_container_status_restarts_total{namespace=\"$namespace\", pod=\"$pod\"})",
        "legendFormat": "Restarts"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 3 },
              { "color": "red", "value": 10 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      }
    },
    {
      "id": 4, "title": "Pod Age (seconds)", "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "prometheus" },
      "targets": [{
        "expr": "time() - kube_pod_start_time{namespace=\"$namespace\", pod=\"$pod\"}",
        "legendFormat": "Age"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 5, "title": "CPU Request vs Limit", "type": "stat",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(kube_pod_container_resource_requests{namespace=\"$namespace\", pod=\"$pod\", resource=\"cpu\"})",
          "legendFormat": "Request"
        },
        {
          "expr": "sum(kube_pod_container_resource_limits{namespace=\"$namespace\", pod=\"$pod\", resource=\"cpu\"})",
          "legendFormat": "Limit"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "cores" } }
    },
    {
      "id": 6, "title": "Memory Request vs Limit", "type": "stat",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(kube_pod_container_resource_requests{namespace=\"$namespace\", pod=\"$pod\", resource=\"memory\"})",
          "legendFormat": "Request"
        },
        {
          "expr": "sum(kube_pod_container_resource_limits{namespace=\"$namespace\", pod=\"$pod\", resource=\"memory\"})",
          "legendFormat": "Limit"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },

    {
      "id": 7, "title": "Pod CPU Usage", "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [{
        "expr": "sum by (container) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", pod=\"$pod\", container!=''}[5m]))",
        "legendFormat": "{{container}}"
      }],
      "fieldConfig": { "defaults": { "unit": "cores" } }
    },
    {
      "id": 8, "title": "Pod Memory Usage", "type": "timeseries",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [{
        "expr": "sum by (container) (container_memory_working_set_bytes{namespace=\"$namespace\", pod=\"$pod\", container!=''})",
        "legendFormat": "{{container}}"
      }],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },

    {
      "id": 9, "title": "Pod Network Received", "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [{
        "expr": "sum(rate(container_network_receive_bytes_total{namespace=\"$namespace\", pod=\"$pod\"}[5m]))",
        "legendFormat": "Received"
      }],
      "fieldConfig": { "defaults": { "unit": "Bps" } }
    },
    {
      "id": 10, "title": "CPU Throttling %", "type": "timeseries",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [{
        "expr": "sum by (container) (rate(container_cpu_cfs_throttled_seconds_total{namespace=\"$namespace\", pod=\"$pod\", container!=''}[5m])) / sum by (container) (rate(container_cpu_cfs_periods_total{namespace=\"$namespace\", pod=\"$pod\", container!=''}[5m])) * 100",
        "legendFormat": "{{container}}"
      }],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100 } }
    }
  ]
}
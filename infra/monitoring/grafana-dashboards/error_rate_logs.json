{
  "title": "Error Rate from Logs",
  "uid": "error-rate-logs",
  "tags": ["loki", "logs", "errors"],
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": { "uid": "loki" },
        "query": {
          "type": "labelValues",
          "label": "namespace",
          "stream": "{}",
          "refId": "A"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": { "uid": "loki" },
        "query": {
          "type": "labelValues",
          "label": "pod",
          "stream": "{namespace=~\"$namespace\"}",
          "refId": "A"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1, "title": "Total Errors (Last 3h)", "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "uid": "loki" },
      "targets": [{
        "expr": "sum(count_over_time({namespace=~\"$namespace\", pod=~\"$pod\"} | logfmt | level=~\"error|err\" [3h]))",
        "legendFormat": "Errors"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      }
    },
    {
      "id": 2, "title": "Total Warnings (Last 3h)", "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "uid": "loki" },
      "targets": [{
        "expr": "sum(count_over_time({namespace=~\"$namespace\", pod=~\"$pod\"} | logfmt | level=~\"warn|warning\" [3h]))",
        "legendFormat": "Warnings"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 20 },
              { "color": "red", "value": 100 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      }
    },
    {
      "id": 3, "title": "Total Logs (Last 3h)", "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "uid": "loki" },
      "targets": [{
        "expr": "sum(count_over_time({namespace=~\"$namespace\", pod=~\"$pod\"} [3h]))",
        "legendFormat": "Total"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" }
        }
      }
    },
    {
      "id": 4, "title": "Error %", "type": "stat",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "uid": "loki" },
      "targets": [{
        "expr": "sum(count_over_time({namespace=~\"$namespace\", pod=~\"$pod\"} | logfmt | level=~\"error|err\" [3h])) / sum(count_over_time({namespace=~\"$namespace\", pod=~\"$pod\"} [3h])) * 100",
        "legendFormat": "Error %"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      }
    },

    {
      "id": 5, "title": "Error Rate over Time", "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 8 },
      "datasource": { "uid": "loki" },
      "targets": [
        {
          "expr": "sum by (namespace) (count_over_time({namespace=~\"$namespace\", pod=~\"$pod\"} | logfmt | level=~\"error|err\" [1m]))",
          "legendFormat": "errors - {{namespace}}"
        },
        {
          "expr": "sum by (namespace) (count_over_time({namespace=~\"$namespace\", pod=~\"$pod\"} | logfmt | level=~\"warn|warning\" [1m]))",
          "legendFormat": "warns - {{namespace}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 10 }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "errors.*" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "warns.*" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }]
          }
        ]
      }
    },

    {
      "id": 6, "title": "Error Rate by Pod", "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "uid": "loki" },
      "targets": [{
        "expr": "sum by (pod) (count_over_time({namespace=~\"$namespace\", pod=~\"$pod\"} | logfmt | level=~\"error|err\" [1m]))",
        "legendFormat": "{{pod}}"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 10 }
        }
      }
    },
    {
      "id": 7, "title": "Warn Rate by Pod", "type": "timeseries",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "uid": "loki" },
      "targets": [{
        "expr": "sum by (pod) (count_over_time({namespace=~\"$namespace\", pod=~\"$pod\"} | logfmt | level=~\"warn|warning\" [1m]))",
        "legendFormat": "{{pod}}"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 10 }
        }
      }
    },

    {
      "id": 8, "title": "Recent Error Logs", "type": "logs",
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 10 },
      "datasource": { "uid": "loki" },
      "targets": [{
        "expr": "{namespace=~\"$namespace\", pod=~\"$pod\"} | logfmt | level=~\"error|err\"",
        "legendFormat": ""
      }],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    }
  ]
}
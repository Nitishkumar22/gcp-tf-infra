{
  "title": "Node Detail",
  "uid": "node-detail",
  "tags": ["kubernetes", "node"],
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": { "uid": "prometheus" },
        "query": "label_values(kube_node_info, node)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 1, "title": "Node Status", "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "prometheus" },
      "targets": [{
        "expr": "kube_node_status_condition{node=\"$node\", condition=\"Ready\", status=\"true\"}",
        "legendFormat": "Ready"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "green", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Not Ready" }, "1": { "text": "Ready" } } }
          ]
        }
      }
    },
    {
      "id": 2, "title": "CPU Cores (Allocatable)", "type": "stat",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "prometheus" },
      "targets": [{
        "expr": "kube_node_status_allocatable{node=\"$node\", resource=\"cpu\"}",
        "legendFormat": "CPU Cores"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 3, "title": "Memory (Allocatable)", "type": "stat",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "prometheus" },
      "targets": [{
        "expr": "kube_node_status_allocatable{node=\"$node\", resource=\"memory\"}",
        "legendFormat": "Memory"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 4, "title": "Pods Running on Node", "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "prometheus" },
      "targets": [{
        "expr": "count(kube_pod_info{node=\"$node\"})",
        "legendFormat": "Pods"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" } } }
    },
    {
      "id": 5, "title": "CPU Usage %", "type": "stat",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "prometheus" },
      "targets": [{
        "expr": "sum(rate(container_cpu_usage_seconds_total{node=\"$node\", container!=''}[5m])) / kube_node_status_allocatable{node=\"$node\", resource=\"cpu\"} * 100",
        "legendFormat": "CPU %"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      }
    },
    {
      "id": 6, "title": "Memory Usage %", "type": "stat",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "prometheus" },
      "targets": [{
        "expr": "sum(container_memory_working_set_bytes{node=\"$node\", container!=''}) / kube_node_status_allocatable{node=\"$node\", resource=\"memory\"} * 100",
        "legendFormat": "Memory %"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      }
    },

    {
      "id": 7, "title": "CPU Usage (Timeseries)", "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{node=\"$node\", container!=''}[5m]))",
          "legendFormat": "Used"
        },
        {
          "expr": "kube_node_status_allocatable{node=\"$node\", resource=\"cpu\"}",
          "legendFormat": "Allocatable"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "cores" } }
    },
    {
      "id": 8, "title": "Memory Usage (Timeseries)", "type": "timeseries",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{node=\"$node\", container!=''})",
          "legendFormat": "Used"
        },
        {
          "expr": "kube_node_status_allocatable{node=\"$node\", resource=\"memory\"}",
          "legendFormat": "Allocatable"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },

    {
      "id": 9, "title": "Disk Read/Write", "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(container_fs_reads_bytes_total{node=\"$node\"}[5m]))",
          "legendFormat": "Read"
        },
        {
          "expr": "sum(rate(container_fs_writes_bytes_total{node=\"$node\"}[5m]))",
          "legendFormat": "Write"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" } }
    },
    {
      "id": 10, "title": "Network I/O", "type": "timeseries",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(container_network_receive_bytes_total{node=\"$node\"}[5m]))",
          "legendFormat": "Received"
        },
        {
          "expr": "sum(rate(container_network_transmit_bytes_total{node=\"$node\"}[5m]))",
          "legendFormat": "Transmitted"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" } }
    },

    {
      "id": 11, "title": "Pod CPU Usage on Node", "type": "timeseries",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [{
        "expr": "sum by (pod, namespace) (rate(container_cpu_usage_seconds_total{node=\"$node\", container!=''}[5m]))",
        "legendFormat": "{{namespace}}/{{pod}}"
      }],
      "fieldConfig": { "defaults": { "unit": "cores" } }
    },
    {
      "id": 12, "title": "Pod Memory Usage on Node", "type": "timeseries",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [{
        "expr": "sum by (pod, namespace) (container_memory_working_set_bytes{node=\"$node\", container!=''})",
        "legendFormat": "{{namespace}}/{{pod}}"
      }],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    }
  ]
}